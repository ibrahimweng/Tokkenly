# The house style, for editors: two spaces, LF, a final newline. Markdown keeps
# trailing whitespace because two spaces at the end of a line are a line break.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
